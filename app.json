{
  "expo": {
    "name": "TrackMyGains",
    "slug": "trackmygains",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/dumbell.png",
    "scheme": "trackmygains",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/dumbell.png",
        "monochromeImage": "./assets/images/dumbell.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jaggerjack61.TrackMyGains",
      "versionCode": 2,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/dumbell.png",
          "color": "#007AFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "apkVersionDate": "20260731",
      "eas": {
        "projectId": "8b463f27-7a4e-43cd-aecf-720f304955d1"
      }
    },
    "owner": "jarai.samuel"
  }
}
